FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 DJANGO_SETTINGS_MODULE=futtech_backend.settings.dev
WORKDIR /app/futtech_backend
COPY futtech_backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY futtech_backend /app/futtech_backend
EXPOSE 8080
CMD sh -c "gunicorn futtech_backend.wsgi:application --bind 0.0.0.0:${PORT} --workers 2 --timeout 30"