@use '../../styles/tokens' as *;
@use '../../styles/mixins' as *;

.authPage {
    min-height: 100vh;
    color: $color-text;
    background:
	linear-gradient(180deg, rgba(5, 8, 16, 0.92) 0%, rgba(5, 8, 16, 0.98) 100%),
	url('/background.jpg') center / cover fixed;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: $space-3 $space-3 $space-5;

    .top {
	@include page-container(78rem);
	display: flex;
	align-items: center;
	justify-content: space-between;
	z-index: 1;

	.logo {
	    height: 4.75rem;
	    max-height: 6rem;
	    width: auto;
	    border-radius: $radius-pill;
	}

	.topActions {
 	    display: flex;
 	    align-items: center;
	    gap: 0.8rem;
	}

	.topMenuToggle {
	    display: none;
	}

	button,
	.button {
 	    min-height: 3rem;
	    padding: $space-2 $space-4;
	    border-radius: $space-1;
	    font-size: $font-size-md;
	    font-weight: 600;
	    border: 0;
 	    cursor: pointer;
	    transition: transform 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
	    text-decoration: none;
	    display: inline-flex;
	    align-items: center;
	    justify-content: center;

	    &:hover {
		transform: translateY(-2px);
	    }
	}

	.button--primary {
	    background: #05F283;
	    color: $color-primary-green;
	    box-shadow: 0 10px 30px rgba(5, 242, 131, 0.35);
	}

	.button--secondary {
	    background: transparent;
	    color: $color-text;
	    border: 1px solid rgba(255, 255, 255, 0.4);
	    padding: $space-2;
	}
    }
}

.authPage__container {
    @include page-container(78rem);
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: $space-4 $space-8;
}

.authPage__panelGrid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: $space-5;
}

.authHeroVideo {
    width: 100%;
    color: $color-text;

    h3 {
	font-size: $font-size-md;
	margin-bottom: $space-2;
	font-weight: 600;
	text-align: center;
    }

    .authHeroVideo__frame {
	width: 100%;
	aspect-ratio: 1 / 1;
	min-height: 12rem;
	border-radius: $radius-lg;
	overflow: hidden;
	box-shadow: $shadow-card;
	background: rgba(0, 0, 0, 0.55);

	iframe {
	    width: 100%;
	    height: 100%;
	    border: 0;
	    display: block;
	}
    }
}

.authFormCard {
    @include app-card;
}

// Use the authenticated navbar's 767px mobile breakpoint and active-menu transition.
@media (max-width: 767px) {
    .authPage {
	.top {
	    position: relative;
	    padding-inline: 0;

	    .logo {
		height: 3rem;
	    }

	    .topMenuToggle {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.3rem;
		width: 2.75rem;
		min-height: 2.75rem;
		height: 2.75rem;
		padding: 0.5rem;
		border: 2px solid grey;
		border-radius: 5px;
		background: rgba(6, 10, 20, 0.95);
		box-shadow: none;

		&:hover {
		    transform: none;
		}

		span {
		    display: block;
		    width: 100%;
		    height: 2px;
		    background: $color-text;
		    transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
		}

		&.active {
		    span:nth-child(1) {
			transform: translateY(0.425rem) rotate(-45deg);
		    }

		    span:nth-child(2) {
			opacity: 0;
		    }

		    span:nth-child(3) {
			transform: translateY(-0.425rem) rotate(45deg);
		    }
		}
	    }

	    .topActions {
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		padding: 1rem;
		box-sizing: border-box;
		background: rgba(6, 10, 20, 0.98);
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		flex-direction: column;
		align-items: stretch;
		gap: 0.75rem;
		transform: translateX(100%);
		visibility: hidden;
		transition: transform 0.3s ease-in-out, visibility 0s linear 0.3s;

		&.active {
		    transform: translateX(0);
		    visibility: visible;
		    transition-delay: 0s;
		}

		.link,
		button {
		    width: 100%;
		}
	    }
	}
    }
}

@include tablet-up {
    .authPage {
	background-position: left;
	padding: $space-4 $space-6 $space-8;
    }

    .authPage__panelGrid {
	grid-template-columns: minmax(20rem, 25rem) minmax(22rem, 28rem);
	justify-content: center;
	align-items: center;
	gap: 2.25rem;
	max-width: 56rem;
    }

    .authHeroVideo {
	h3 {
	    margin-bottom: $space-3;
	    font-size: 1.1rem;
	}

	.authHeroVideo__frame {
	    min-height: 32.4rem;
	}
    }

    .authFormCard {
	min-height: 28rem;
	padding: $space-6 $space-8;
	display: flex;
	flex-direction: column;
	justify-content: center;
    }
}
