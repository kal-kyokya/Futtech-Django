server {
    listen 443 ssl http2; # managed by Certbot
    listen [::]:443 ssl http2; # managed by Certbot
    server_name futtech.kalkyokya.tech www.futtech.kalkyokya.tech;

    ssl_certificate /etc/letsencrypt/live/kalkyokya.tech/fullchain.pem; # managed by Certbot
 # Certbot managed
    ssl_certificate_key /etc/letsencrypt/live/kalkyokya.tech/privkey.pem; # managed by Certbot
 # Certbot managed
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    # Server API Requests
    location /auth/ {
    	     proxy_pass http://localhost:8080/auth/;
	     proxy_http_version 1.1;
	     proxy_set_header Host $host;
	     proxy_set_header X-Real-IP $remote_addr;

    	     access_log /var/log/nginx/auth_access.log;
	     error_log /var/log/nginx/auth_error.log;
    }

    location /users/ {
    	     proxy_pass http://localhost:8080/users/;

    	     access_log /var/log/nginx/users_access.log;
	     error_log /var/log/nginx/users_error.log;
    }

    location /videos/ {
    	     proxy_pass http://localhost:8080/videos/;

    	     access_log /var/log/nginx/videos_access.log;
	     error_log /var/log/nginx/videos_error.log;
    }

    location /lists/ {
    	     proxy_pass http://localhost:8080/lists/;

    	     access_log /var/log/nginx/lists_access.log;
	     error_log /var/log/nginx/lists_error.log;
    }

    # Server React app
    location / {
    	     root /var/www/Futtech/frontend/dist;
	     index index.html index.htm;
	     proxy_http_version 1.1;
	     proxy_set_header Upgrade $http_upgrade;
	     proxy_set_header Connection 'upgrade';
	     proxy_set_header Host $host;
	     proxy_cache_bypass $http_upgrade;

	     try_files $uri $uri/ /index.html;
    }
}

server {
    if ($host = www.futtech.kalkyokya.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = futtech.kalkyokya.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name futtech.kalkyokya.tech www.futtech.kalkyokya.tech;
    return 404; # managed by Certbot
}
