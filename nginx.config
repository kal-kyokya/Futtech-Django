# --- Force HTTP -> HTTPS
server {
       listen 80;
       listen [::]:80;
       server_name futtech.kalkyokya.tech ww.futtech.kalkyokya.tech;
       return 301 https://$host$request_uri;
}

# --- HTTPS server
server {
       listen 443 ssl http2;
       listen [::]:443 ssl http2;
       server_name futtech.kalkyokya.tech www.futtech.kalkyokya.tech;

       # --- TLS (Certbot-managed) ---
       ssl_certificate /etc/letsencrypt/live/kalkyokya.tech/fullchain.pem;
       ssl_certificate_key /etc/letsencrypt/live/kalkyokya.tech/privkey.pem;
       include /etc/letsencrypt/options-ssl-nginx.conf;
       ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

       # --- Logs (optional per-location logs removed for simplicity) ---
       access_log /var/log/nginx/futtech_access.log;
       error_log /var/log/nginx/futtech_error.log;

       # --- Security headers (basic set) ---
       add_header X-Content-Type-Options nosniff always;
       add_header X-Frame-Options SAMEORIGIN always;
       add_header Referrer-Policy strict-origin-when-cross-origin always;

       # --- Performance ---
       gzip on;
       gzip_types text/plain text/css application/javascript application/json image/svg+xml;
       gzip_min_length 256;

       # --- Upload limits (adjustable if one uploads large files) ---
       client_max_body_size 50m;

       # --- Serve Django static files collected to STATIC_ROOT ---
       # STATIC_ROOT is expected to be:
       #     /home/jpkk/Futtech-Django/futtech_backend/staticfiles
       location /static/ {
       		alias /home/jpkk/Futtech-Django/futtech_backend/staticfiles/;
		expires 30d;
		add_header Cache-Control "public, max-age=2592000, immutable";
       }

       # --- Proxy ALL API routes to Django via Gunicorn (Unix socket)
       # We keep NO trailing path in proxy_pass, so Nginx forwards the client URI unchanged.
       location /api/ {
       		include /etc/nginx/proxy_params;
		proxy_pass http://unix:/run/gunicorn-futtech/gunicorn.sock;
       }

       # Django admin (excluded from the SPA)
       location /admin/ {
       		include /etc/nginx/proxy_params;
		proxy_pass http://unix:/run/gunicorn-futtech/gunicorn.sock;
       }

       # --- Serve the React SPA at root ---
       root /var/www/Futtech/frontend/dist;
       index index.html;

       location / {
       		try_files $uri /index.html;
       }

       # Block dangerous dotfiles (.env, .git, etc.) bar ACME
       location ^~ /.well-known/acme-challenge/ { allow all; default_type "text/plain"; }
       location ~ /\.(?!well-known) { deny all; }
}
